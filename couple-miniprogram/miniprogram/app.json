{
  "pages": [
    "pages/index/index",
    "pages/calendar/calendar",
    "pages/records/records",
    "pages/plans/plans",
    "pages/rewards/rewards",
    "pages/albums/albums",
    "pages/timeline/timeline",
    "pages/settings/settings",
    "pages/record-form/record-form",
    "pages/record-detail/record-detail",
    "pages/pomodoro/pomodoro",
    "pages/search/search",
    "pages/export/export",
    "pages/integration-test/integration-test"
  ],
  "subpackages": [
    {
      "root": "features",
      "pages": [
        "notifications/notifications",
        "reward-store/reward-store",
        "love-agent/love-agent"
      ]
    }
  ],
  "darkmode": true,
  "themeLocation": "theme.json",
  "window": {
    "navigationBarTitleText": "恋爱记录",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "今天",
        "iconPath": "@tabIconToday",
        "selectedIconPath": "@tabIconTodayActive"
      },
      {
        "pagePath": "pages/calendar/calendar",
        "text": "日历",
        "iconPath": "@tabIconCalendar",
        "selectedIconPath": "@tabIconCalendarActive"
      },
      {
        "pagePath": "pages/records/records",
        "text": "记录",
        "iconPath": "@tabIconRecords",
        "selectedIconPath": "@tabIconRecordsActive"
      },
      {
        "pagePath": "pages/settings/settings",
        "text": "我们",
        "iconPath": "@tabIconUs",
        "selectedIconPath": "@tabIconUsActive"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}
