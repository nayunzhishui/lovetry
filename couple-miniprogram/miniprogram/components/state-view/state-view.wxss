/* 页面状态视图：颜色全部走全局 CSS 变量，暗色由 app.wxss 统一驱动 */
.state-view { margin-top: 24rpx; padding: 52rpx 28rpx; border: 1rpx dashed var(--line); background: var(--surface); color: var(--ink-soft); text-align: center; }
.state-view--error { border-style: solid; border-left: 6rpx solid var(--coral); }
.state-view__mark { width: 40rpx; height: 6rpx; margin: 0 auto 22rpx; background: linear-gradient(90deg, var(--cobalt) 0 44%, transparent 44% 56%, var(--coral) 56%); }
.state-view__pulse { width: 16rpx; height: 16rpx; margin: 0 auto 22rpx; border-radius: 50%; background: var(--amber); animation: state-view-pulse 1.1s ease-in-out infinite alternate; }
.state-view__icon { margin-bottom: 16rpx; color: var(--coral); font-size: 46rpx; line-height: 1; }
.state-view__title { color: var(--ink-strong); font-size: 28rpx; font-weight: 650; }
.state-view__description { margin-top: 12rpx; font-size: 23rpx; line-height: 1.65; }
.state-view__action { min-height: 88rpx; margin: 24rpx auto 0; padding: 0 44rpx; border-radius: 6rpx; background: var(--chip-active-bg); color: var(--chip-active-ink); font-size: 23rpx; line-height: 88rpx; }
@keyframes state-view-pulse {
  from { opacity: 0.35; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1.15); }
}
@media (prefers-reduced-motion: reduce) {
  .state-view__pulse { animation: none; }
}
