.dialog-mask { position: fixed; inset: 0; z-index: 99; display: flex; align-items: flex-end; background: rgba(18,30,34,.48); }
.dialog-sheet { width: 100%; padding: 38rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--surface); }
.dialog-code { color: var(--cobalt); font-family: Menlo,Consolas,monospace; font-size: 19rpx; letter-spacing: 3rpx; }
.dialog-title { margin-top: 14rpx; color: var(--ink-strong); font-family: "Songti SC",STSong,serif; font-size: 38rpx; font-weight: 700; }
.dialog-detail { margin-top: 14rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.7; }
.dialog-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 32rpx; }
.dialog-actions button { border-radius: 6rpx; background: var(--surface-muted); color: var(--ink-strong); }
.dialog-actions .is-danger { background: var(--coral); color: var(--paper); }
