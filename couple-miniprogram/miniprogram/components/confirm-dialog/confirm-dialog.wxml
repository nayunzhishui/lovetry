<view wx:if="{{open}}" class="dialog-mask" bindtap="cancel"><view class="dialog-sheet" aria-role="dialog" aria-modal="true" aria-label="{{title}}" catchtap="stop"><view class="dialog-code" aria-hidden="true">REVIEW ACTION</view><view class="dialog-title">{{title}}</view><view class="dialog-detail">{{detail}}</view><view class="dialog-actions"><button bindtap="cancel">返回</button><button class="is-danger" bindtap="confirm">{{confirmText}}</button></view></view></view>
