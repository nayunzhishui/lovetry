<view class="page records-page">
  <view class="hero records-hero">
    <twin-rail />
    <view class="eyebrow">OUR DAILY NOTES</view>
    <view class="title">生活记录</view>
    <view class="subtitle">共享的留在双轨上，私密的只属于你。</view>
  </view>

  <state-view wx:if="{{needsCouple}}" mode="couple-required" />

  <block wx:else>
  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <button
        wx:for="{{typeOptions}}"
        wx:key="value"
        class="filter-chip {{selectedType === item.value ? 'filter-chip--active' : ''}}"
        aria-role="tab"
        aria-selected="{{selectedType === item.value}}"
        data-type="{{item.value}}"
        bindtap="selectType"
      >{{item.label}}</button>
    </view>
  </scroll-view>

  <view class="action-row">
    <button class="button compact" data-type="{{selectedType}}" bindtap="createRecord">新增记录</button>
    <button class="button secondary compact" data-type="pomodoro" bindtap="createRecord">开始专注</button>
  </view>
  <view wx:if="{{selectedType === 'outing'}}" class="outing-filters">
    <scroll-view scroll-x show-scrollbar="{{false}}"><view class="filter-row">
      <button wx:for="{{outingCategories}}" wx:key="*this" class="filter-chip {{outingCategory === item ? 'filter-chip--active' : ''}}" aria-role="tab" aria-selected="{{outingCategory === item}}" data-category="{{item}}" bindtap="selectOutingCategory">{{item || '全部分类'}}</button>
    </view></scroll-view>
    <view class="date-filter"><picker mode="date" value="{{filterDate}}" bindchange="selectFilterDate"><view class="input-like">{{filterDate || '按日期筛选'}}</view></picker><button wx:if="{{filterDate}}" bindtap="clearFilterDate">清除</button></view>
  </view>

  <view wx:if="{{insight}}" class="insight-card">
    <view class="panel-kicker">{{insight.eyebrow}}</view>
    <view class="insight-title">{{insight.title}}</view>
    <view class="insight-metrics">
      <view wx:for="{{insight.metrics}}" wx:key="label" class="insight-metric">
        <text>{{item.value}}</text><view>{{item.label}}</view>
      </view>
    </view>
    <view wx:if="{{insight.bars.length}}" class="insight-chart" aria-label="{{insight.unit}}">
      <view wx:for="{{insight.bars}}" wx:key="key" class="insight-row">
        <text class="insight-row__label">{{item.label}}</text>
        <view class="insight-row__track"><view class="insight-row__fill" style="width: {{item.width}}%;"></view></view>
        <text class="insight-row__value">{{item.valueText}}</text>
      </view>
      <view class="insight-unit">{{insight.unit}}</view>
    </view>
    <view class="insight-note">{{insight.note}}</view>
  </view>

  <view wx:if="{{stats}}" class="stats-strip">
    <view class="stats-item"><text>{{stats.last7DaysMinutes}}</text><view>近 7 天{{stats.modeLabel}} / 分钟</view></view>
    <view class="stats-divider"></view>
    <view class="stats-item"><text>{{stats.last30DaysMinutes}}</text><view>近 30 天{{stats.modeLabel}} / 分钟</view></view>
    <view class="stats-divider"></view>
    <view class="stats-item"><text>{{stats.last30DaysCount}}</text><view>近 30 天 / 次</view></view>
  </view>
  <view wx:if="{{stats.trendText}}" class="stats-trend">{{stats.trendText}}</view>

  <state-view wx:if="{{isLoading}}" variant="loading" title="正在整理记录…" />

  <state-view
    wx:elif="{{error}}"
    variant="error"
    title="记录暂时没有加载出来"
    description="{{error}}"
    actionText="重新加载"
    bind:action="loadRecords"
  />

  <state-view
    wx:elif="{{records.length === 0}}"
    variant="empty"
    title="这里还没有记录"
    description="写下今天最想记住的一件小事。"
    actionText="写第一条"
    bind:action="createRecord"
  />

  <view wx:else class="record-list">
    <button
      wx:for="{{records}}"
      wx:key="_id"
      class="record record-card"
      hover-class="record-card--pressed"
      data-id="{{item._id}}"
      bindtap="openRecord"
    >
      <view class="record-card__head">
        <view class="record-type">{{item.typeLabel}}</view>
        <view class="record-visibility">{{item.visibilityLabel}}</view>
      </view>
      <view class="record-title">{{item.title || item.typeLabel}}</view>
      <view class="record-meta">{{item.timeText}}<text wx:if="{{item.durationText}}"> · {{item.durationText}}</text></view>
      <view wx:if="{{item.categoryText}}" class="record-category">{{item.categoryText}}</view>
      <view wx:if="{{item.contentPreview}}" class="record-content">{{item.contentPreview}}</view>
      <view class="record-arrow" aria-hidden="true">›</view>
    </button>
    <view wx:if="{{loadingMore}}" class="list-footer" aria-live="polite">加载更多中…</view>
    <view wx:elif="{{!hasMore && records.length > 0}}" class="list-footer">没有更多了</view>
  </view>
  </block>
</view>
