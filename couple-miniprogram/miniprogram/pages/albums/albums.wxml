<view class="page">
  <view class="hero"><twin-rail /><view class="eyebrow">TWO-PERSON ARCHIVE</view><view class="title">共同相册</view><view class="subtitle">照片只属于当前情侣空间，不作为公开动态。</view></view>

  <state-view wx:if="{{needsCouple}}" mode="couple-required" />

  <block wx:else>
  <view class="panel">
    <view class="panel-title">新建相册</view>
    <input value="{{newTitle}}" placeholder="例如：厦门旅行" bindinput="onTitleInput" />
    <textarea value="{{newDescription}}" maxlength="500" auto-height placeholder="可选：写下这本相册的时间或故事" bindinput="onDescriptionInput" />
    <button class="button" disabled="{{loading || !newTitle}}" bindtap="createAlbum">创建相册</button>
  </view>

  <scroll-view wx:if="{{albums.length}}" scroll-x class="album-strip">
    <view class="album-strip__inner">
      <button wx:for="{{albums}}" wx:key="_id" class="album-pill {{selectedAlbum && selectedAlbum._id === item._id ? 'album-pill--active' : ''}}" data-id="{{item._id}}" bindtap="openAlbum">{{item.title}}</button>
    </view>
  </scroll-view>

  <view wx:if="{{selectedAlbum}}" class="panel-head album-head">
    <view><view class="panel-kicker">当前相册</view><view class="panel-title">{{selectedAlbum.title}}</view></view>
    <button class="button compact" loading="{{uploading}}" disabled="{{uploading}}" bindtap="chooseAndUpload">加入照片</button>
  </view>
  <view wx:if="{{selectedAlbum}}" class="album-tools">
    <input value="{{renameTitle}}" maxlength="60" placeholder="相册名称" bindinput="onRenameInput" />
    <textarea value="{{editDescription}}" maxlength="500" auto-height placeholder="相册说明（可选）" bindinput="onEditDescriptionInput" />
    <button class="button secondary compact" bindtap="renameAlbum">保存信息</button>
    <button class="button secondary compact danger-button" bindtap="deleteAlbum">删空相册</button>
  </view>
  <view wx:if="{{uploadProgress}}" class="upload-progress">{{uploadProgress}}</view>

  <view wx:if="{{error}}" class="error-banner">{{error}}</view>
  <state-view wx:if="{{loading && !albums.length}}" variant="loading" title="正在整理相册…" />
  <state-view
    wx:elif="{{!albums.length && !error}}"
    variant="empty"
    title="还没有相册"
    description="用上面的表单建第一本相册，收藏只属于你们的照片。"
  />
  <state-view
    wx:if="{{!loading && selectedAlbum && assets.length === 0}}"
    variant="empty"
    title="相册还是空的"
    description="选择几张只属于你们的照片。"
  />
  <view wx:if="{{selectedAlbum && assets.length}}" class="hint">点按照片可预览；长按可设为封面或删除。</view>
  <view class="photo-grid">
    <view wx:for="{{assets}}" wx:key="_id" class="photo-wrap">
      <image src="{{item.tempURL}}" mode="aspectFill" class="photo" data-url="{{item.tempURL}}" data-id="{{item._id}}" bindtap="preview" bindlongpress="onPhotoActions" />
      <view class="photo-date">{{item.createdAtText}}</view>
      <view wx:if="{{selectedAlbum.coverAssetId === item._id}}" class="photo-cover-badge">封面</view>
    </view>
  </view>
  <button wx:if="{{hasMore}}" class="button secondary load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多照片</button>
  </block>
</view>
