<view class="page index-page">
  <view class="hero home-hero">
    <twin-rail />
    <view class="eyebrow">OUR DAYS</view>
    <view class="title">恋爱记录</view>
    <view class="subtitle">把共同经历和沟通结果放在同一条时间线上，慢慢看见两个人的生活。</view>
  </view>

  <view wx:if="{{isLoading && !couple}}" class="state-card" aria-live="polite">
    <view class="state-pulse"></view>
    <view>正在打开你们的空间…</view>
  </view>

  <view wx:elif="{{error && !couple}}" class="empty empty--home" aria-live="polite">
    <view class="empty-title">首页暂时没有加载出来</view>
    <view class="empty-desc">{{error}}</view>
    <button class="button" bindtap="loadCouple">重新加载</button>
  </view>

  <view wx:elif="{{!couple}}" class="empty empty--home">
    <view class="empty-title">还没有情侣空间</view>
    <view class="empty-desc">创建或加入一个只属于两个人的空间，再开始同步记录。</view>
    <button class="button" bindtap="goSettings">设置情侣空间</button>
    <button class="button secondary" bindtap="goLoveAgent">先问恋爱助手</button>
  </view>

  <view wx:else>
    <button class="sync-ribbon {{syncFailed ? 'sync-ribbon--failed' : ''}}" bindtap="retrySync"><view class="sync-ribbon__light"></view><text>{{syncText}}</text></button>
    <button wx:if="{{couple.status === 'archiving'}}" class="archiving-note" bindtap="goSettings">这个空间正处于解除冷静期，{{archivingDaysLeft}} 天后将归档；任何一方都可以在设置页撤销，或先导出备份。</button>
    <button wx:if="{{syncDigestText}}" class="sync-digest" bindtap="openSyncDigest">{{syncDigestText}} · 去看看</button>
    <view class="panel space-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">SHARED SPACE</view>
          <view class="panel-title">当前情侣空间</view>
        </view>
        <view class="status">{{couple.members.length < 2 ? '等待 TA 加入' : '已连接'}}</view>
      </view>
      <view class="space-code">{{couple.code}}</view>
      <view class="hint">这是邀请另一半加入当前空间的加入码</view>
      <view wx:if="{{couple.members.length < 2}}" class="space-waiting">
        <view class="hint space-waiting__hint">空间还差一个人：把加入码发给 TA，加入后你们的内容会自动同步。</view>
        <button class="button secondary compact" bindtap="copyInviteCode">复制加入码</button>
      </view>
    </view>

    <view wx:if="{{summary}}" class="today-strip">
      <button class="today-metric" bindtap="goPendingTasks"><view class="today-metric__value">{{summary.pendingTasks.length}}</view><view class="today-metric__label">待完成任务</view></button>
      <button class="today-metric" bindtap="goTodayAgenda"><view class="today-metric__value">{{summary.todayPlans.length}}</view><view class="today-metric__label">今日安排</view></button>
      <button class="today-metric" bindtap="goRewards"><view class="today-metric__value">{{walletText || '0'}}</view><view class="today-metric__label">两人积分</view></button>
    </view>
    <view wx:if="{{summary}}" class="relationship-note">
      <button class="relationship-note__cell" bindtap="goAnniversarySetup"><text>{{togetherDays || '—'}}</text><view>{{togetherDays ? '在一起的第几天' : '点这里设置纪念日'}}</view></button>
      <view><text>{{recentMoodText}}</text><view>最近的心情线索</view></view>
    </view>
    <view wx:if="{{summary.stats}}" class="week-summary">近 7 天：{{summary.stats.recordCount7d}} 条记录 · {{summary.stats.focusMinutes7d}} 分钟专注</view>
    <button wx:if="{{pendingApprovals > 0}}" class="almanac-card approvals-card" bindtap="goPendingApprovals">
      <view><view class="almanac-code" aria-hidden="true">NEEDS YOUR OK</view><view class="record-title">有 {{pendingApprovals}} 件事等你确认</view><view class="record-meta">奖励提议与兑换正等你回应</view></view>
      <view class="approvals-card__arrow" aria-hidden="true">›</view>
    </button>
    <view class="today-actions">
      <button bindtap="goMood"><view class="today-actions__mark today-actions__mark--me"></view><view><text>记录心情</text><view>留下一条自己的感受</view></view></button>
      <button bindtap="goTodayPlan"><view class="today-actions__mark today-actions__mark--us"></view><view><text>安排今天</text><view>给两个人留出时间</view></view></button>
      <button bindtap="goConflict"><view class="today-actions__mark today-actions__mark--talk"></view><view><text>沟通复盘</text><view>把事实与需要分开写</view></view></button>
    </view>
    <button wx:if="{{upcomingAnniversary}}" class="almanac-card anniversary-card" bindtap="goPlans">
      <view><view class="almanac-code" aria-hidden="true">NEXT ANNIVERSARY</view><view class="record-title">{{upcomingAnniversary.title}}</view><view class="record-meta">{{upcomingAnniversary.next.date}}</view></view>
      <view class="anniversary-card__count"><text>{{upcomingAnniversary.next.daysRemaining}}</text><view>{{upcomingAnniversary.next.daysRemaining === 0 ? '今天' : '天后'}}</view></view>
    </button>

    <view wx:if="{{summary && dailyQuestion}}" class="panel daily-question">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">DAILY QUESTION</view>
          <view class="panel-title">今日一问</view>
        </view>
        <view class="status">{{dailyStatusText}}</view>
      </view>
      <view class="daily-question__text">{{dailyQuestion.text}}</view>
      <view class="hint">每天一道小问题，回答后就能看到彼此的答案。</view>
      <block wx:if="{{!dailyAnsweredByMe}}">
        <button wx:if="{{!dailyAnswerOpen}}" class="button secondary compact" bindtap="openDailyAnswer">写下我的回答</button>
        <view wx:else class="daily-question__composer">
          <textarea class="daily-question__input" value="{{dailyAnswerText}}" maxlength="500" placeholder="写一两句就好" bindinput="onDailyAnswerInput" aria-label="今日一问的回答" />
          <button class="button compact" loading="{{dailySubmitting}}" disabled="{{dailySubmitting}}" bindtap="submitDailyAnswer">提交回答</button>
        </view>
      </block>
      <block wx:else>
        <view wx:if="{{dailyMyAnswer}}" class="daily-question__mine">我的回答：{{dailyMyAnswer}}</view>
        <button wx:if="{{dailyAnsweredByPartner}}" class="button secondary compact" bindtap="goTimeline">去时间线看看</button>
      </block>
    </view>

    <view class="section-head">
      <view>
        <view class="panel-kicker">QUICK START</view>
        <view class="section-title">今天想做什么</view>
      </view>
    </view>

    <view class="nav-grid">
      <button class="nav-item" bindtap="goRecords">
        <view class="nav-mark"></view>
        <view class="nav-title">生活记录</view>
        <view class="nav-desc">日记、心情、玩乐、睡眠、生理与亲密、游戏、专注</view>
      </button>
      <button class="nav-item" bindtap="goCalendar">
        <view class="nav-mark"></view>
        <view class="nav-title">共同日历</view>
        <view class="nav-desc">把计划与回忆放在一起</view>
      </button>
      <button class="nav-item" bindtap="goPlans">
        <view class="nav-mark"></view>
        <view class="nav-title">共同计划</view>
        <view class="nav-desc">任务清单、事件、菜单、旅行和纪念日</view>
      </button>
      <button class="nav-item" bindtap="goRewards">
        <view class="nav-mark"></view>
        <view class="nav-title">奖励账户</view>
        <view class="nav-desc">获得、消费与兑换流水</view>
      </button>
      <button class="nav-item" bindtap="goAlbums">
        <view class="nav-mark"></view>
        <view class="nav-title">共同相册</view>
        <view class="nav-desc">保存只属于两个人的照片</view>
      </button>
      <button class="nav-item" bindtap="goSearch">
        <view class="nav-mark"></view>
        <view class="nav-title">搜索回忆</view>
        <view class="nav-desc">按关键词找到记录和计划</view>
      </button>
      <button class="nav-item" bindtap="goTimeline">
        <view class="nav-mark"></view>
        <view class="nav-title">共同动态</view>
        <view class="nav-desc">沿时间线回看两个人的共同瞬间</view>
      </button>
      <button class="nav-item nav-item--agent" bindtap="goLoveAgent">
        <view class="nav-mark"></view>
        <view class="nav-title">恋爱助手 · AI</view>
        <view class="nav-desc">基于本地恋爱知识库，帮你梳理沟通、边界和相处问题</view>
      </button>
    </view>

    <view class="write-today">
      <button class="button" bindtap="goWriteToday">写今天</button>
      <view class="write-today__hint">用一篇生活日记，留下今天最想共同记住的事。</view>
    </view>
  </view>
</view>
