.home-hero {
  padding-bottom: 24rpx;
}

.sync-ribbon {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 6rpx 0 18rpx;
  color: var(--ink-soft);
  font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  width: 100%;
  min-height: 64rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.5;
  text-align: left;
}

.sync-ribbon__light {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--sage);
  box-shadow: 0 0 0 6rpx rgba(115, 142, 120, 0.12);
}

.sync-ribbon--failed { color: var(--danger); }
.sync-ribbon--failed .sync-ribbon__light { background: var(--danger); box-shadow: 0 0 0 6rpx rgba(168, 88, 78, 0.12); }

.sync-digest {
  width: 100%;
  margin: 0 0 18rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--line);
  border-left: 6rpx solid var(--cobalt);
  border-radius: var(--radius-md);
  background: var(--surface);
  color: var(--ink);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: left;
  box-shadow: var(--shadow-card);
}

.space-waiting {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--line);
}

.space-waiting__hint {
  margin-bottom: 16rpx;
  color: var(--amber-deep);
}

.approvals-card {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-color: var(--amber);
  border-left-color: var(--amber);
  text-align: left;
}

.approvals-card .almanac-code { color: var(--amber-deep); }
.approvals-card__arrow { color: var(--ink-soft); font-size: 40rpx; }

.empty--home {
  padding-top: 46rpx;
  padding-bottom: 34rpx;
  background: rgba(255, 253, 248, 0.62);
}

.empty--home .button {
  margin-top: 30rpx;
}

.space-card {
  position: relative;
  overflow: hidden;
}

.space-card::after {
  position: absolute;
  right: -28rpx;
  bottom: -44rpx;
  width: 130rpx;
  height: 92rpx;
  border: 2rpx solid rgba(115, 142, 120, 0.18);
  border-radius: 50%;
  content: "";
}

.space-code {
  margin-top: 24rpx;
  color: var(--ink-strong);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  line-height: 1.25;
  word-break: break-all;
}

.section-head {
  display: flex;
  justify-content: space-between;
  margin-top: 48rpx;
  padding: 0 4rpx;
}

.section-title {
  color: var(--ink-strong);
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 700;
}

/* 首页加载态（还没有 couple 数据时展示） */
.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 32rpx;
  padding: 60rpx 24rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
}

.state-pulse {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--amber);
  animation: index-pulse 1.1s ease-in-out infinite alternate;
}

@keyframes index-pulse {
  from { opacity: 0.35; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1.1); }
}

@media (prefers-reduced-motion: reduce) {
  .state-pulse { animation: none; }
}

/* "写今天"入口：替代原首页内嵌日记表单 */
.write-today {
  margin-top: 46rpx;
  text-align: center;
}

.write-today .button {
  width: 100%;
}

.write-today__hint {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 20rpx;
  line-height: 1.5;
}

.today-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 22rpx;
}

.today-metric {
  width: 100%;
  min-height: 116rpx;
  margin: 0;
  padding: 24rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface);
  text-align: center;
  line-height: 1.35;
}

.today-metric__value {
  color: var(--ink-strong);
  font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
  font-size: 32rpx;
  font-weight: 700;
}

.today-metric__label {
  margin-top: 7rpx;
  color: var(--ink-soft);
  font-size: 20rpx;
}

.nav-item--agent { grid-column: 1 / -1; min-height: 142rpx; border-top-color: var(--sage); }
.nav-item--agent .nav-mark { background: var(--sage); }
.relationship-note { display: grid; grid-template-columns: .8fr 1.2fr; gap: 1rpx; margin-top: 14rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: var(--radius-md); background: var(--line); }
.relationship-note > view { padding: 20rpx; background: var(--surface); }
.relationship-note text { display: block; color: var(--ink-strong); font-family: "Songti SC", "STSong", serif; font-size: 28rpx; font-weight: 700; }
.relationship-note view view { margin-top: 6rpx; color: var(--ink-soft); font-size: 20rpx; }
.week-summary { margin-top: 10rpx; color: var(--ink-soft); font-size: 20rpx; text-align: right; }
.today-actions { display: grid; gap: 8rpx; margin-top: 20rpx; padding: 8rpx; border: 1rpx solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
.today-actions button { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; margin: 0; padding: 12rpx 14rpx; border-radius: var(--radius-sm); background: transparent; color: var(--ink-strong); line-height: 1.35; text-align: left; }
.today-actions__mark { flex: 0 0 8rpx; width: 8rpx; height: 48rpx; border-radius: 4rpx; background: var(--cobalt); }
.today-actions__mark--us { background: linear-gradient(to bottom, var(--cobalt) 0 45%, var(--coral) 45% 55%, var(--sage) 55%); }
.today-actions__mark--talk { background: var(--coral); }
.today-actions text { display: block; font-size: 23rpx; font-weight: 700; }
.today-actions button view view { margin-top: 3rpx; color: var(--ink-soft); font-size: 20rpx; }
.anniversary-card { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 24rpx; margin-right: 0; margin-left: 0; text-align: left; line-height: 1.5; }
.anniversary-card__count { min-width: 120rpx; color: var(--coral); text-align: right; }
.anniversary-card__count text { font-family: "Songti SC", STSong, serif; font-size: 58rpx; line-height: 1; }
.anniversary-card__count view { margin-top: 6rpx; color: var(--ink-soft); font-size: 21rpx; }

@media (max-width: 340px) {
  .today-strip { grid-template-columns: 1fr; }
  .today-metric { display: flex; min-height: 80rpx; align-items: center; justify-content: space-between; padding: 16rpx 20rpx; text-align: left; }
  .today-metric__label { margin-top: 0; }
}

/* 暗色下取消奶油色半透明衬底，避免刺眼 */
@media (prefers-color-scheme: dark) {
  .empty--home { background: rgba(27, 42, 47, 0.62); }
}

/* 解绑冷静期提示条：温和提示，点击去设置页处理 */
.archiving-note {
  width: 100%;
  margin: 0 0 18rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--line);
  border-left: 6rpx solid var(--danger);
  border-radius: var(--radius-md);
  background: var(--surface);
  color: var(--ink);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: left;
  box-shadow: var(--shadow-card);
}

/* 在一起天数指标改为可点击（未设置纪念日时跳设置页） */
.relationship-note__cell {
  width: 100%;
  margin: 0;
  padding: 20rpx;
  border-radius: 0;
  background: var(--surface);
  line-height: 1.5;
  text-align: left;
}

.relationship-note__cell > view {
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 20rpx;
}

/* 今日一问卡片 */
.daily-question { margin-top: 20rpx; }

.daily-question__text {
  margin-top: 18rpx;
  color: var(--ink-strong);
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
}

.daily-question .hint { margin-top: 10rpx; }
.daily-question .button { margin-top: 22rpx; }

.daily-question__composer { margin-top: 8rpx; }

.daily-question__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 140rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1.6;
}

.daily-question__mine {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--sage);
  background: var(--amber-soft-bg);
  color: var(--ink);
  font-size: 23rpx;
  line-height: 1.6;
}
