<view class="page timeline-page">
  <view class="hero timeline-hero">
    <twin-rail />
    <view class="eyebrow">TOGETHER, IN TIME</view>
    <view class="title">共同时间线</view>
    <view class="subtitle">两条生活轨迹，在一次次共同经历里相遇。</view>
  </view>

  <state-view wx:if="{{needsCouple}}" mode="couple-required" />

  <block wx:else>
    <view class="timeline-toolbar">
      <view>
        <view class="panel-kicker">ALL MOMENTS</view>
        <view class="timeline-count">共 {{records.length}} 条记录</view>
      </view>
      <button class="button secondary compact" bindtap="loadRecords">刷新</button>
    </view>

    <state-view wx:if="{{isLoading && records.length === 0}}" loading="{{true}}" description="正在把两个人的动态放回时间线。" />

    <state-view
      wx:elif="{{error && records.length === 0}}"
      title="时间线暂时没有加载出来"
      description="{{error}}"
      actionText="重新加载"
      bind:action="loadRecords"
    />

    <view wx:elif="{{records.length === 0}}" class="empty">
      <view class="dual-empty" aria-hidden="true">
        <view></view><view></view>
      </view>
      <view class="empty-title">时间线还没有内容</view>
      <view class="empty-desc">在首页点「写今天」保存第一篇日记后，它会出现在这里。</view>
    </view>

    <view wx:else class="timeline-list">
      <view class="timeline-tracks" aria-hidden="true">
        <view class="timeline-track timeline-track--amber"></view>
        <view class="timeline-track timeline-track--sage"></view>
      </view>
      <view wx:for="{{records}}" wx:key="_id" class="record timeline-record">
        <view class="timeline-node" aria-hidden="true"></view>
        <view class="record-type">{{item.typeLabel}}</view>
        <view class="record-title">{{item.title}}</view>
        <view class="record-meta">{{item.createdAtText}}</view>
        <view class="record-content">{{item.content}}</view>
        <view class="reaction-row">
          <button wx:for="{{item.reactions}}" wx:for-item="reaction" wx:key="value" class="reaction-chip {{reaction.active ? 'is-active' : ''}}" data-id="{{item._id}}" data-reaction="{{reaction.value}}" bindtap="react">{{reaction.label}}<text wx:if="{{reaction.count}}"> {{reaction.count}}</text></button>
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="list-footer" aria-live="polite">加载更多中…</view>
    <view wx:elif="{{!hasMore && records.length > 0}}" class="list-footer">没有更多了</view>
  </block>
</view>
