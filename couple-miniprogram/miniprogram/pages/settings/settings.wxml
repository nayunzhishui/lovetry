<view class="page settings-page">
  <view class="hero">
    <twin-rail />
    <view class="eyebrow">PRIVATE SPACE</view>
    <view class="title">情侣空间</view>
    <view class="subtitle">两个人共用一个空间。创建后，把加入码单独发给另一半。</view>
  </view>

  <view wx:if="{{couple && ceremonyStep}}" class="panel ceremony-card">
    <view class="panel-kicker">TOGETHER</view>
    <block wx:if="{{ceremonyStep === 'celebrate'}}">
      <view class="panel-title">你们的空间建好了</view>
      <view class="hint">从今天起，记录、计划和回忆都会放在同一个地方。</view>
      <button class="button" bindtap="ceremonyNext">下一步：记下在一起的日子</button>
      <button class="button secondary compact" bindtap="ceremonySkip">稍后再说</button>
    </block>
    <block wx:elif="{{ceremonyStep === 'anniversary'}}">
      <view class="panel-title">你们是从哪一天开始的？</view>
      <view class="hint">设置"在一起的日子"，首页会一直帮你们数着天数。</view>
      <picker mode="date" value="{{ceremonyDate}}" bindchange="onCeremonyDateChange">
        <view class="input-like profile-date">{{ceremonyDate || '选择日期'}}</view>
      </picker>
      <button class="button" disabled="{{isSaving}}" bindtap="ceremonyConfirmDate">就是这一天</button>
      <button class="button secondary compact" bindtap="ceremonySkip">稍后再说</button>
    </block>
    <block wx:elif="{{ceremonyStep === 'days'}}">
      <view class="panel-title">今天是你们在一起的第 {{ceremonyDays}} 天</view>
      <view class="hint">往后每一天，都值得慢慢记下来。</view>
      <button class="button" bindtap="ceremonyFinish">回首页看看</button>
    </block>
  </view>

  <view wx:if="{{couple && couple.status === 'archiving'}}" class="panel archiving-panel">
    <view class="panel-kicker">COOLING OFF</view>
    <view class="panel-title">解除申请已发起，{{archivingDaysLeft}} 天后生效</view>
    <view class="hint">冷静期内你们仍可查看和导出全部数据；任何一方都可以撤销这次解除。</view>
    <button class="button" disabled="{{isSaving}}" bindtap="revokeLeave">撤销解除</button>
    <button class="button secondary compact" bindtap="goExport">先导出备份</button>
  </view>

  <view wx:if="{{couple}}" class="panel code-card">
    <view class="panel-head">
      <view>
        <view class="panel-kicker">INVITE CODE</view>
        <view class="panel-title">当前加入码</view>
      </view>
      <view class="status status--warm">{{couple.members.length < 2 ? '等待 TA 加入' : '两人已连接'}}</view>
    </view>
    <view wx:if="{{couple.members.length < 2}}" class="hint waiting-hint">空间已建好，把加入码发给 TA，加入后就能一起记录。</view>
    <view class="invite-code">{{couple.code}}</view>
    <view class="hint">仅发送给你的伴侣，不要发布在公开平台。</view>
    <view wx:if="{{couple.members.length < 2}}" class="invite-actions">
      <button class="button compact" bindtap="copyInviteCode">复制加入码</button>
      <button class="button compact" open-type="share">分享给 TA</button>
      <button class="button secondary compact" disabled="{{isSaving}}" bindtap="refreshInvite">更新加入码</button>
    </view>
  </view>

  <view wx:if="{{couple}}" class="panel">
    <view class="panel-kicker">SPACE PROFILE</view>
    <view class="panel-title">两个人的资料</view>
    <view class="field"><view class="label">空间名称</view><input value="{{spaceName}}" maxlength="30" placeholder="我们的小空间" data-key="spaceName" bindinput="onProfileInput" /></view>
    <view class="field"><view class="label">在一起的日期</view><picker mode="date" value="{{anniversaryDate}}" bindchange="onAnniversaryChange"><view class="input-like profile-date">{{anniversaryDate || '选择日期'}}</view></picker></view>
    <button class="button" disabled="{{isSaving}}" bindtap="saveProfile">保存资料</button>
  </view>

  <view wx:if="{{!couple}}" class="panel action-panel">
    <view class="panel-kicker">CONNECT</view>
    <view class="panel-title">建立两个人的连接</view>
    <view class="connection-choice">
      <view class="choice-index">A</view>
      <view class="choice-body">
        <view class="label">还没有空间</view>
        <view class="hint">由其中一人创建，再分享加入码。</view>
      </view>
    </view>
    <button class="button" bindtap="createCouple">创建情侣空间</button>

    <view class="choice-divider">
      <view class="choice-divider__line"></view>
      <view class="choice-divider__text">或</view>
      <view class="choice-divider__line"></view>
    </view>

    <view class="connection-choice">
      <view class="choice-index choice-index--sage">B</view>
      <view class="choice-body">
        <view class="label">已经收到加入码</view>
        <view class="hint">输入对方发来的 8 位加入码。</view>
      </view>
    </view>
    <view class="field join-field">
      <view class="label">加入码</view>
      <input class="join-input" value="{{joinCode}}" maxlength="8" placeholder="请输入 8 位加入码" bindinput="onJoinCodeInput" />
    </view>
    <button class="button secondary" bindtap="joinCouple">加入情侣空间</button>
  </view>

  <view wx:if="{{couple}}" class="panel tools-panel">
    <view class="panel-kicker">DATA & REMINDERS</view>
    <button class="tool-row" bindtap="goExport"><view><view class="label">数据备份</view><view class="hint">导出共享数据和自己的私密记录</view></view><text>›</text></button>
    <button class="tool-row" bindtap="goNotifications"><view><view class="label">提醒中心</view><view class="hint">任务、纪念日和奖励确认提醒</view></view><text>›</text></button>
    <button wx:if="{{showDeveloperTools}}" class="tool-row" bindtap="goIntegrationTest"><view><view class="label">联调检查</view><view class="hint">检查云函数和数据库连接</view></view><text>›</text></button>
  </view>

  <view wx:if="{{couple}}" class="panel privacy-panel">
    <view class="panel-kicker">PRIVACY BY DEFAULT</view>
    <view class="panel-title">敏感记录默认只对自己可见</view>
    <view class="hint">心情、沟通复盘、睡眠、生理期、亲密和专注记录会先保存为私密内容；你可在编辑时主动改为两人共享。</view>
  </view>

  <button wx:if="{{couple && couple.status !== 'archiving'}}" class="leave-button" disabled="{{isSaving}}" bindtap="leaveCouple">解除当前情侣空间</button>
  <confirm-dialog
    open="{{showLeaveConfirm}}"
    title="申请解除当前情侣空间？"
    detail="申请后进入 7 天冷静期：期间双方仍可查看数据、可随时撤销，期间请先导出备份；7 天后空间将归档，双方都无法再查看共享数据。"
    confirm-text="确认申请解除"
    bindcancel="cancelLeave"
    bindconfirm="confirmLeave"
  />
</view>
